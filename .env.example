# Copia este archivo a .env.local (local) o crea estas variables en Vercel → Settings → Environment Variables.
# Sin ellas la tienda arranca en MODO DEMO con un catálogo de prueba.

# URL de tu WordPress + WooCommerce, sin barra final
WC_URL=https://admin.tutienda.com

# WooCommerce → Ajustes → Avanzado → REST API → Añadir clave (permisos: Lectura/Escritura)
# Créala para un usuario dedicado, no para el administrador principal.
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dominio público de la tienda, sin barra final. Opcional hasta que tengas dominio propio:
# sin esta variable se usa el dominio de producción de Vercel (o http://localhost:3000 en local).
# NEXT_PUBLIC_SITE_URL=https://traelo.co
