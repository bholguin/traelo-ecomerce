# Copia este archivo a .env.local (local) o crea estas variables en Vercel → Settings → Environment Variables.
# Sin DROPI_TOKEN la tienda arranca en MODO DEMO con un catálogo de prueba y no crea pedidos.

# Token de integración: dropi.co → Mis tiendas → crea/abre tu tienda → copia el token.
DROPI_TOKEN=

# Opcional: IDs de productos de Dropi separados por coma (se suman a src/config/productos.ts)
DROPI_PRODUCT_IDS=

# Opcional: otro país o entorno. Por defecto Colombia.
# DROPI_API_URL=https://api.dropi.co/integrations/

# Recomendado en producción: evita pedidos duplicados cuando el celular reintenta.
# Vercel → Storage → Upstash Redis las crea solas al conectar la base al proyecto.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
